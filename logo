import turtle
import math

# Screen setup
screen = turtle.Screen()
screen.setup(700, 700)
screen.bgcolor("white")
screen.title("ASAC CSE Logo")

t = turtle.Turtle()
t.speed(0)
t.pensize(4)

# ---------- Circle ----------
t.penup()
t.goto(0, -250)
t.pendown()
t.circle(250)

# ---------- Rectangle (Computer Screen) ----------
def rectangle(x, y, width, height):
    t.penup()
    t.goto(x, y)
    t.setheading(0)
    t.pendown()

    for i in range(2):
        t.forward(width)
        t.left(90)
        t.forward(height)
        t.left(90)

rectangle(-150, 50, 300, 180)

# ---------- Triangle (Cursor) ----------
t.penup()
t.goto(-50, 180)
t.pendown()

t.goto(20, 70)
t.goto(55, 110)
t.goto(85, 75)
t.goto(-50, 180)

# ---------- Ellipse ----------
t.penup()
t.goto(-130, 20)
t.setheading(0)
t.pendown()

# Draw ellipse
for i in range(360):
    x = 130 * math.cos(math.radians(i))
    y = 25 * math.sin(math.radians(i))
    t.goto(-0 + x, 20 + y)

# ---------- Lines (Circuit Connections) ----------
# Left lines
t.penup()
t.goto(-150, 140)
t.pendown()
t.goto(-210, 140)

t.penup()
t.goto(-150, 100)
t.pendown()
t.goto(-210, 100)

# Right lines
t.penup()
t.goto(150, 140)
t.pendown()
t.goto(210, 140)

t.penup()
t.goto(150, 100)
t.pendown()
t.goto(210, 100)

# ---------- ASAC ----------
t.penup()
t.goto(-80, -80)
t.setheading(0)
t.write("ASAC", font=("Arial", 32, "bold"))

# ---------- CSE ----------
t.penup()
t.goto(-35, -125)
t.write("CSE", font=("Arial", 20, "bold"))

# Hide turtle
t.hideturtle()

turtle.done()